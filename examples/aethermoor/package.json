{
  "name": "aethermoor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Академия Этермур — браузерная магическая RPG",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/server.mjs\" \"vite\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "test:server": "node scripts/server-test.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:tour": "node scripts/tour.mjs",
    "check": "npm run typecheck && npm run validate && npm run test:server"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
}
