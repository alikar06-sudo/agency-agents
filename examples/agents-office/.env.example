# Ключ Anthropic. Без него панель работает в демо-режиме.
ANTHROPIC_API_KEY=

# Название магазина в шапке панели.
AO_SHOP=Vitaflow · американские витамины

# Модель. По умолчанию claude-opus-5.
AO_MODEL=claude-opus-5

# Сеть. Для запуска за nginx оставьте 127.0.0.1.
AO_HOST=127.0.0.1
PORT=8787

# Пароль на вход в панель. Пустое значение = без пароля (только для localhost!).
AO_TOKEN=

# Сколько задач выполняется одновременно.
AO_CONCURRENCY=2

# Где хранить журнал и задачи.
AO_DATA_DIR=./data
